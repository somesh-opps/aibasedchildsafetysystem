# ===================================
# Environment Variables Configuration
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# ===================================
# MongoDB Atlas Settings
# ===================================
# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=childdatadb

# ===================================
# Arduino/RFID Settings
# ===================================
ARDUINO_SERIAL_PORT=COM4
ARDUINO_BAUD_RATE=9600
# Comma-separated list of authorized RFID card IDs (UPPERCASE)
RFID_AUTHORIZED_CARDS=CARD_ID_1,CARD_ID_2

# ===================================
# Directory and File Paths
# ===================================
# Path to students directory containing student images and guardian info
STUDENTS_DIR=/path/to/AI-Based-Child-Safety-System/STUDENTS

# Path to output log file
OUTPUT_FILE=/path/to/AI-Based-Child-Safety-System/attendance_log.txt

# ===================================
# Camera Settings
# ===================================
CAM_INDEX=0

# ===================================
# Face Recognition Settings
# ===================================
DETECTION_MODEL=hog
TOLERANCE=0.6
FRAME_SCALE=0.5
PROCESS_EVERY_N=2

# ===================================
# WhatsApp Settings
# ===================================
WHATSAPP_WAIT_TIME=4
ENTER_DELAY_SEC=8
WHATSAPP_TAB_CLOSE_DELAY=12

# Message templates (use {name}, {ts}, {student}, {guardian} as placeholders)
CHECKIN_MESSAGE_TEMPLATE={name} is present.\nEntry date & time: {ts}
CHECKOUT_MESSAGE_TEMPLATE={student} checked out with Guardian: {guardian}\nDate & Time: {ts}
